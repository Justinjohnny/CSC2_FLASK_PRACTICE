{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Flask App",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "cwd": "${workspaceFolder}",
            "env": {
                "FLASK_APP": "app.py",
                "FLASK_DEBUG": "1"
            },
            "args": [
                "run",
                "--host",
                "127.0.0.1",
                "--port",
                "5000"
            ],
            "console": "integratedTerminal",
            "jinja": true,
            "justMyCode": true,
            "serverReadyAction": {
                "pattern": "Running on (http://127.0.0.1:5000)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}
